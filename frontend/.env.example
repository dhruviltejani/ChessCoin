# ==============================================================================
# ChessCoin Frontend Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#    cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# 2. Replace placeholder values with your actual configuration.
# ==============================================================================

# Google OAuth 2.0 Client ID
# Obtain from Google Cloud Console (https://console.cloud.google.com/):
#   - Create OAuth 2.0 Web Application credentials
#   - Add Authorized JavaScript Origins: http://localhost:5173
# Must match GOOGLE_CLIENT_ID in Backend/.env
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Backend API Base URL (Default: http://localhost:5000)
VITE_API_URL=http://localhost:5000
