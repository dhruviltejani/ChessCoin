# ==============================================================================
# ChessCoin Backend Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#    cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# 2. Replace placeholder values with your actual configuration.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL (Configured for CORS origin validation; comma-separated for multiple origins, no trailing slash)
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Configuration
# For Neon / Render production, set DATABASE_URL (e.g. postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require)
# For local Postgres, you can specify DATABASE_URL or individual connection parameters:
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/chesscoin_dev
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost                       
DB_PORT=5432
DB_NAME=chesscoin_dev

# Google OAuth 2.0 Client ID
# Obtain from Google Cloud Console (APIs & Services > Credentials)
# Must match VITE_GOOGLE_CLIENT_ID in frontend/.env
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ==============================================================================
# Email Configuration (for Password Reset & Notifications)
#
# Option 1 (Recommended for Render Free Tier): Resend HTTPS API (port 443)
# Render Free Tier blocks outbound SMTP ports (25, 465, 587). Setting
# RESEND_API_KEY sends emails over HTTPS via Resend instead of SMTP.
# ==============================================================================
RESEND_API_KEY=
EMAIL_FROM="ChessCoin Security <onboarding@resend.dev>"

# ==============================================================================
# Option 2: Nodemailer / SMTP Configuration (Local Dev or Paid Render Plans)
# If both RESEND_API_KEY and SMTP_* are left blank, development mode
# automatically uses an Ethereal test inbox or logs reset links to console.
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

