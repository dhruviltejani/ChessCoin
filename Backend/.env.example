# ==============================================================================
# ChessCoin Backend Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#    cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# 2. Replace placeholder values with your actual configuration.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL (Configured for CORS origin validation)
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Configuration
# You can specify a full connection string or individual connection parameters:
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/chesscoin_dev
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chesscoin_dev

# Google OAuth 2.0 Client ID
# Obtain from Google Cloud Console (APIs & Services > Credentials)
# Must match VITE_GOOGLE_CLIENT_ID in frontend/.env
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
